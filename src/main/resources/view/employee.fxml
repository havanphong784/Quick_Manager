<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.quickmanager.controller.EmployeeController">
    <BorderPane styleClass="qm-page"
                AnchorPane.topAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0">

        <top>
            <VBox spacing="10" styleClass="qm-topbar">
                <Label text="Quản lí nhân viên" styleClass="qm-page-title"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <TextField fx:id="txtTuKhoa" promptText="Tìm theo tên/sđt/email..." HBox.hgrow="ALWAYS" styleClass="qm-input"/>
                    <ComboBox fx:id="cbTrangThai" onAction="#handleTimKiem" promptText="Trạng thái" styleClass="qm-combo"/>
                    <Button fx:id="btnTimKiem" onAction="#handleTimKiem" text="Tìm kiếm" styleClass="qm-btn"/>
                </HBox>
            </VBox>
        </top>

        <center>
            <SplitPane dividerPositions="0.62" styleClass="qm-content">
                <VBox spacing="10" styleClass="qm-panel qm-panel-left">
                    <Label text="Danh sách nhân viên" styleClass="qm-section-title"/>

                    <TableView fx:id="tbNhanVien" styleClass="qm-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMaNV" text="Mã NV" maxWidth="60"/>
                            <TableColumn fx:id="colHoTen" text="Họ tên" maxWidth="400"/>
                            <TableColumn fx:id="colSdt" text="SDT" maxWidth="200"/>
                            <TableColumn fx:id="colDiaChi" text="Địa chỉ" maxWidth="200"/>
                            <TableColumn fx:id="colTrangThai" text="Trạng thái" maxWidth="160"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <Label fx:id="lblTongNhanVien" text="Tổng nhân viên: 0" styleClass="qm-label-muted"/>
                </VBox>

                <Region prefWidth="20" minWidth="20" maxWidth="20"/>

                <VBox spacing="10" styleClass="qm-panel qm-panel-right">
                    <Label text="Thông tin nhân viên" styleClass="qm-section-title"/>

                    <GridPane hgap="10" vgap="8" styleClass="qm-form">
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" minWidth="95"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Mã nhân viên" styleClass="qm-label-muted" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtMaNV" disable="true" styleClass="qm-input" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Họ tên" styleClass="qm-label-muted" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtTenNV" promptText="Nhập họ tên" styleClass="qm-input" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Ngày sinh" styleClass="qm-label-muted" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <DatePicker fx:id="dpNgaySinh" promptText="Ngày sinh" styleClass="qm-input" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Giới Tính" styleClass="qm-label-muted" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cbGioiTinh" promptText="Giới Tính" styleClass="qm-combo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Số điện thoại" styleClass="qm-label-muted" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtSdt" promptText="Nhập số điện thoại" styleClass="qm-input" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Email" styleClass="qm-label-muted" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtEmail" promptText="Nhập email" styleClass="qm-input" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="Địa chỉ" styleClass="qm-label-muted" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtDiaChi" promptText="Nhập địa chỉ" styleClass="qm-input" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                        <Label text="Trạng thái" styleClass="qm-label-muted" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cbFormTrangThai" styleClass="qm-combo" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                        <HBox spacing="8" GridPane.rowIndex="8" GridPane.columnIndex="0" GridPane.columnSpan="2">
                            <Button fx:id="btnMoi" onAction="#handleMoi" text="Mới" styleClass="qm-btn" HBox.hgrow="ALWAYS"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnThem" onAction="#handleThem" text="Thêm" styleClass="qm-btn" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnCapNhat" onAction="#handleCapNhat" text="Cập nhật" styleClass="qm-btn" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </GridPane>
                </VBox>
            </SplitPane>
        </center>
    </BorderPane>
</AnchorPane>


<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.quickmanager.controller.ProductController">
    <BorderPane styleClass="qm-page"
                AnchorPane.topAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0">

        <top>
            <VBox spacing="10" styleClass="qm-topbar">
                <Label alignment="CENTER_LEFT" text="Quản lí sản phẩm" styleClass="qm-page-title"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <TextField fx:id="txtTuKhoa" promptText="Tìm theo tên/mã/barcode..." HBox.hgrow="ALWAYS" styleClass="qm-input"/>
                    <ComboBox fx:id="cbDanhMuc" onAction="#handleTimKiem" promptText="Danh mục" styleClass="qm-combo"/>
                    <ComboBox fx:id="cbTrangThai" onAction="#handleTimKiem" promptText="Trạng thái" styleClass="qm-combo"/>
                    <Button fx:id="btnTimKiem" onAction="#handleTimKiem" text="Tìm kiếm" styleClass="qm-btn"/>
                </HBox>
            </VBox>
        </top>

        <center>
            <SplitPane dividerPositions="0.62" styleClass="qm-content">
                <VBox spacing="10" styleClass="qm-panel qm-panel-left">
                    <Label text="Danh sách sản phẩm" styleClass="qm-section-title"/>

                    <TableView fx:id="tbSanPham" styleClass="qm-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMaSP" text="Mã SP" prefWidth="110"/>
                            <TableColumn fx:id="colTenSP" text="Tên sản phẩm"/>
                            <TableColumn fx:id="colDanhMuc" text="Danh mục" prefWidth="120"/>
                            <TableColumn fx:id="colTonKho" text="Tồn kho" prefWidth="90"/>
                            <TableColumn fx:id="colGiaNhap" text="Giá nhập" prefWidth="110"/>
                            <TableColumn fx:id="colGiaBan" text="Giá bán" prefWidth="110"/>
                            <TableColumn fx:id="colTrangThai" text="Trạng thái" prefWidth="110"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                    <Label fx:id="lblTongSoSP" text="Tổng sản phẩm: 0" styleClass="qm-label-muted"/>
                </VBox>

                <Region prefWidth="20" minWidth="20" maxWidth="20"/>

                <VBox spacing="10" styleClass="qm-panel qm-panel-right">
                    <Label text="Thông tin sản phẩm" styleClass="qm-section-title"/>

                    <GridPane hgap="10" vgap="8" styleClass="qm-form">
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" minWidth="95"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Mã sản phẩm" styleClass="qm-label-muted" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtFormMaSP" promptText="VD: SP001" styleClass="qm-input" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Tên sản phẩm" styleClass="qm-label-muted" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtFormTenSP" promptText="Nhập tên sản phẩm" styleClass="qm-input" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Danh mục" styleClass="qm-label-muted" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cbFormDanhMuc" promptText="Chọn danh mục" styleClass="qm-combo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Đơn vị tính" styleClass="qm-label-muted" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtFormDVT" promptText="VD: Cái, Hộp" styleClass="qm-input" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Tồn kho" styleClass="qm-label-muted" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtFormTonKho" promptText="0" styleClass="qm-input" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Giá nhập" styleClass="qm-label-muted" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtFormGiaNhap" promptText="0" styleClass="qm-input" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="Giá bán" styleClass="qm-label-muted" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtFormGiaBan" promptText="0" styleClass="qm-input" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                        <Label text="Barcode" styleClass="qm-label-muted" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtFormBarcode" promptText="Nhập barcode" styleClass="qm-input" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                        <Label text="Trạng thái" styleClass="qm-label-muted" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cbFormTrangThai" promptText="Đang kinh doanh" styleClass="qm-combo" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                        <HBox spacing="8" GridPane.rowIndex="9" GridPane.columnIndex="0" GridPane.columnSpan="2">
                            <Button fx:id="btnThem" text="Thêm" styleClass="qm-btn" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnCapNhat" text="Cập nhật" styleClass="qm-btn" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnXoa" text="Xóa" styleClass="btn-red" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </GridPane>
                </VBox>
            </SplitPane>
        </center>
    </BorderPane>
</AnchorPane>


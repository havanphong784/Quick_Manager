<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.quickmanager.controller.ImportController">
    <BorderPane styleClass="qm-page"
                AnchorPane.topAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0">

        <top>
            <VBox spacing="10" styleClass="qm-topbar">
                <Label text="Nhập hàng" styleClass="qm-page-title"/>
            </VBox>
        </top>

        <center>
            <SplitPane dividerPositions="0.5" styleClass="qm-content">
                <VBox spacing="10" styleClass="qm-panel qm-panel-left">
                    <Label text="Thêm mặt hàng" styleClass="qm-section-title"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField HBox.hgrow="ALWAYS" fx:id="txtTimSanPham"
                                   onAction="#loadTbMH"
                                   promptText="Tìm tên/mã sản phẩm..."
                                   styleClass="qm-input"/>
                        <TextField fx:id="txtSoLuongNhap"
                                   promptText="SL"
                                   prefWidth="90"
                                   styleClass="qm-input"/>
                        <Button fx:id="btnThemMH"
                                onAction="#handleThem"
                                text="Thêm"
                                styleClass="qm-btn"/>
                    </HBox>


                    <TableView fx:id="tbSanPham" styleClass="qm-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="clMaSP" text="Mã SP" prefWidth="80"/>
                            <TableColumn fx:id="clTenSP" text="Tên sản phẩm"/>
                            <TableColumn fx:id="clDVT" text="ĐVT" prefWidth="60"/>
                            <TableColumn fx:id="clTonKho" text="Tồn" prefWidth="60"/>
                            <TableColumn fx:id="clGiaNhap" text="Giá nhập" prefWidth="110"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                </VBox>

                <!-- Spacer like sell page -->
                <Region prefWidth="20" minWidth="20" maxWidth="20"/>

                <!-- RIGHT: Product table + import info -->
                <VBox spacing="10" styleClass="qm-panel qm-panel-right">
                    <Label text="Danh sách mặt hàng đã thêm" styleClass="qm-section-title"/>

                    <TableView fx:id="tbSanPhamDT" styleClass="qm-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMaSP" text="Mã SP" prefWidth="80"/>
                            <TableColumn fx:id="colSLNhap" text="Số lượng" prefWidth="90"/>
                            <TableColumn fx:id="colGiaNhap" text="Đơn giá" prefWidth="110"/>
                            <TableColumn fx:id="colThanhTien" text="Thành tiền" prefWidth="130"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <HBox spacing="8">
                        <Button fx:id="btnXoaDong" onAction="#xoaDong" text="Xóa dòng" styleClass="qm-btn"/>
                        <Button fx:id="btnXoaDon" onAction="#xoaHet" text="Xóa đơn" styleClass="qm-btn"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTongTien" text="Tổng tiền: _ VNĐ" styleClass="qm-total-value"/>
                    </HBox>

                    <GridPane hgap="10" vgap="8" styleClass="qm-form">
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" minWidth="95"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Tên NCC" styleClass="qm-label-muted" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtTenNCC" promptText="Tên nhà cung cấp" styleClass="qm-input" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Liên hệ" styleClass="qm-label-muted" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtLienHeNCC" promptText="Số điện thoại" styleClass="qm-input" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Địa chỉ" styleClass="qm-label-muted" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtDiaChiNCC" promptText="Địa chỉ NCC" styleClass="qm-input" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Email" styleClass="qm-label-muted" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtEmail" promptText="Ghi chú thêm..." styleClass="qm-input" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="TỔNG CỘNG" styleClass="qm-total-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <Label fx:id="lblTongCong" text="0 VNĐ" styleClass="qm-total-value" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                    </GridPane>


                    <HBox spacing="8">
                        <ComboBox fx:id="cbNCC" onAction="#handleCbNCC" promptText="Chọn nhà cung cấp" styleClass="qm-combo"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnXacNhan" onAction="#handleXacNhan" text="Xác nhận nhập" styleClass="qm-btn"/>
                    </HBox>
                </VBox>
            </SplitPane>
        </center>
    </BorderPane>
</AnchorPane>

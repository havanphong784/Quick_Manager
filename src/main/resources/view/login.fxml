<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600" prefWidth="900"
            style="-fx-background-color: #0f172a;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <ImageView fitHeight="600" fitWidth="900" pickOnBounds="true" preserveRatio="false" smooth="false"
               AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="0.0">
        <Image url="@../images/background.jpg"/>
    </ImageView>

    <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">
        <VBox maxWidth="420.0" prefWidth="420.0" spacing="16.0"
              style="-fx-background-color: RGBA(250,250,250,0.5); -fx-background-radius: 18;">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="28.0"/>
            </padding>
            <Label text="Quick Manager">
                <font>
                    <Font name="System Bold" size="30.0"/>
                </font>
                <style>-fx-text-fill: #0f172a;</style>
            </Label>

            <Label text="Đăng nhập để tiếp tục." style="-fx-text-fill: #64748b; -fx-font-size: 14;"/>

            <Separator/>

            <VBox spacing="8.0">
                <Label text="Tài khoản"
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <TextField fx:id="usernameField" promptText="Nhập tên đăng nhập"
                           style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #cbd5e1; -fx-padding: 10 12; -fx-font-size: 14;"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Mật khẩu"
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu"
                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #cbd5e1; -fx-padding: 10 12; -fx-font-size: 14;"/>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <CheckBox fx:id="rememberMeCheckBox" text="Ghi nhớ mật khẩu"
                          style="-fx-text-fill: #334155;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Quên mật khẩu ?" style="-fx-text-fill: #2563eb;"/>
            </HBox>

            <HBox>
                <Button fx:id="loginButton" defaultButton="true" mnemonicParsing="false" prefHeight="42.0"
                        text="Đăng nhập"
                        style="-fx-background-color: #2563eb; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="regiterButton" defaultButton="true" mnemonicParsing="false" prefHeight="42.0"
                        text="Đăng ký"
                        style="-fx-background-color: #2563eb; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
            </HBox>

            <Label fx:id="statusLabel" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 12;"/>
        </VBox>
    </VBox>
</AnchorPane>


<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="dashBoard" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefHeight="768" prefWidth="1366"
            fx:controller="com.quickmanager.controller.DashBoardController">
    <left>
        <BorderPane styleClass="sideBar" minWidth="270" prefWidth="270" prefHeight="Infinity">
            <top>
                <StackPane styleClass="logoPane" prefHeight="90" BorderPane.alignment="CENTER">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <StackPane.margin>
                            <Insets left="38"/>
                        </StackPane.margin>
                        <ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                            <Image url="@/images/logo.png"/>
                        </ImageView>
                        <Label styleClass="logo" text="QUICK"/>
                    </HBox>
                </StackPane>
            </top>
            <center>
                <VBox fx:id="menu" styleClass="sidebar-menu" spacing="10">
                    <fx:define>
                        <ToggleGroup fx:id="sidebarGroup"/>
                    </fx:define>
                    <ToggleButton fx:id="btnMenuHome" onAction="#switchHomePage" text="  Trang chủ" styleClass="menu-btn" toggleGroup="$sidebarGroup" selected="true">
                        <graphic>
                            <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                <Image url="@/images/home.png"/>
                            </ImageView>
                        </graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnMenuSell" onAction="#switchSellPage" text="  Bán hàng" styleClass="menu-btn" toggleGroup="$sidebarGroup">
                        <graphic>
                            <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                <Image url="@/images/cart.png"/>
                            </ImageView>
                        </graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnMenuImport" onAction="#switchImportPage" text="  Nhập hàng" styleClass="menu-btn" toggleGroup="$sidebarGroup">
                        <graphic>
                            <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                <Image url="@/images/import.png"/>
                            </ImageView>
                        </graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnMenuInvoice" onAction="#switchInvoicePage" text="  Hóa đơn" styleClass="menu-btn" toggleGroup="$sidebarGroup">
                        <graphic>
                            <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                <Image url="@/images/invoice.png"/>
                            </ImageView>
                        </graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnMenuProduct" onAction="#switchProductPage" text="  Quản lí sản phẩm" styleClass="menu-btn" toggleGroup="$sidebarGroup">
                        <graphic>
                            <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                <Image url="@/images/order.png"/>
                            </ImageView>
                        </graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnMenuEmployee" onAction="#switchEmployeePage" text="  Quản lí nhân viên" styleClass="menu-btn" toggleGroup="$sidebarGroup">
                        <graphic>
                            <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                <Image url="@/images/employee.png"/>
                            </ImageView>
                        </graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="btnMenuStatistics" onAction="#switchStatisticsPage" text="  Thống kê" styleClass="menu-btn" toggleGroup="$sidebarGroup">
                        <graphic>
                            <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                <Image url="@/images/bar-chart.png"/>
                            </ImageView>
                        </graphic>
                    </ToggleButton>
                    <Region fx:id="menuRegion" VBox.vgrow="ALWAYS"/>
                    <HBox fx:id="menuFooter">
                        <Button onAction="#handleLogout" text="Đăng xuất" styleClass="menu-btn">
                            <graphic>
                                <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                    <Image url="@/images/logout.png"/>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button alignment="CENTER" onAction="#handleSwitchTheme" text="" styleClass="menu-btn">
                            <graphic>
                                <ImageView fitWidth="30" fitHeight="30" preserveRatio="true">
                                    <Image url="@/images/moon.png"/>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Region prefWidth="60"/>
                    </HBox>
                </VBox>
            </center>

        </BorderPane>
    </left>

    <center>
        <BorderPane styleClass="mainPane" prefWidth="Infinity">
            <top>
                <HBox styleClass="header" prefHeight="90" alignment="CENTER" spacing="12"
                      onMousePressed="#handleHeaderPressed"
                      onMouseDragged="#handleHeaderDragged">
                    <VBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="Chào mừng đến QuickManager" styleClass="qm-page-title"/>
                        <Label text="Quản lý bán hàng nhanh và hiệu quả" styleClass="qm-label-muted"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox spacing="2" alignment="TOP_RIGHT">
                        <HBox spacing="6" alignment="CENTER_RIGHT">
                            <Button text="_" styleClass="window-control-btn" onAction="#handleMinimize"/>
                            <Button text="[ ]" styleClass="window-control-btn" onAction="#handleMaximize"/>
                            <Button text="X" styleClass="window-control-btn window-close-btn" onAction="#handleClose"/>
                        </HBox>
                        <Label fx:id="accountLabel" styleClass="header-label" text="Phongha"/>
                        <Label fx:id="roleLabel" styleClass="qm-label-muted" text="Admin"/>
                    </VBox>
                </HBox>
                
            </top>
            <center>
                <AnchorPane fx:id="contentPane"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>

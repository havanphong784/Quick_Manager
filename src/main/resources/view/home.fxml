<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <BorderPane styleClass="sell-page"
                AnchorPane.topAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0">

        <top>
            <VBox spacing="10" styleClass="sell-topbar">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Trang chủ" styleClass="sell-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Hôm nay" styleClass="sell-meta-label"/>
                    <DatePicker fx:id="dpHomNay" styleClass="qm-combo"/>
                    <Button fx:id="btnTaiLai" text="Tải lại" styleClass="qm-btn"/>
                </HBox>
            </VBox>
        </top>

        <center>
            <VBox spacing="10" styleClass="sell-center-pane">
                <HBox spacing="10">
                    <VBox spacing="6" styleClass="sell-panel" HBox.hgrow="ALWAYS">
                        <Label text="Doanh thu hôm nay" styleClass="sell-summary-label"/>
                        <Label fx:id="lblDoanhThuHomNay" text="0 VNĐ" styleClass="sell-total-value"/>
                    </VBox>
                    <VBox spacing="6" styleClass="sell-panel" HBox.hgrow="ALWAYS">
                        <Label text="Đơn hàng hôm nay" styleClass="sell-summary-label"/>
                        <Label fx:id="lblDonHangHomNay" text="0" styleClass="sell-summary-value"/>
                    </VBox>
                    <VBox spacing="6" styleClass="sell-panel" HBox.hgrow="ALWAYS">
                        <Label text="Sản phẩm sắp hết" styleClass="sell-summary-label"/>
                        <Label fx:id="lblSanPhamSapHet" text="0" styleClass="sell-change-value"/>
                    </VBox>
                </HBox>

                <SplitPane dividerPositions="0.55" styleClass="sell-center-pane" VBox.vgrow="ALWAYS">
                    <VBox spacing="10" styleClass="sell-panel sell-panel-left">
                        <Label text="Hoạt động gần đây" styleClass="sell-section-title"/>
                        <TableView fx:id="tblHoatDongGanDay" styleClass="sell-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colThoiGian" text="Thời gian" prefWidth="150"/>
                                <TableColumn fx:id="colNguoiThucHien" text="Nhân viên" prefWidth="130"/>
                                <TableColumn fx:id="colHanhDong" text="Hành động"/>
                                <TableColumn fx:id="colGiaTri" text="Giá trị" prefWidth="120"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                    <Region prefWidth="20" minWidth="20" maxWidth="20"/>

                    <VBox spacing="10" styleClass="sell-panel sell-panel-right">
                        <Label text="Tác vụ nhanh" styleClass="sell-section-title"/>
                        <GridPane hgap="10" vgap="10" styleClass="sell-summary-pane" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Button fx:id="btnBanHangNhanh" text="Bán hàng" styleClass="qm-btn" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Button fx:id="btnNhapHangNhanh" text="Nhập hàng" styleClass="qm-btn" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Button fx:id="btnHoaDonNhanh" text="Hóa đơn" styleClass="qm-btn" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Button fx:id="btnSanPhamNhanh" text="Sản phẩm" styleClass="qm-btn" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Button fx:id="btnNhanVienNhanh" text="Nhân viên" styleClass="qm-btn" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Button fx:id="btnThongKeNhanh" text="Thống kê" styleClass="qm-btn" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>
                </SplitPane>
            </VBox>
        </center>
    </BorderPane>
</AnchorPane>


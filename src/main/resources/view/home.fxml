<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quickmanager.controller.HomeController">
    <BorderPane styleClass="qm-page"
                AnchorPane.topAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0">

        <top>
            <VBox spacing="10" styleClass="qm-topbar">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Trang chủ" styleClass="qm-page-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </top>

        <center>
            <VBox spacing="10" styleClass="qm-content">
                <HBox spacing="10">
                    <VBox spacing="6" styleClass="qm-panel" HBox.hgrow="ALWAYS">
                        <Label text="Doanh thu hôm nay" styleClass="qm-label-muted"/>
                        <Label fx:id="lblDoanhThuHomNay" text="0 VNĐ" styleClass="qm-total-value"/>
                    </VBox>
                    <VBox spacing="6" styleClass="qm-panel" HBox.hgrow="ALWAYS">
                        <Label text="Đơn hàng hôm nay" styleClass="qm-label-muted"/>
                        <Label fx:id="lblDonHangHomNay" text="0" styleClass="qm-value"/>
                    </VBox>
                    <VBox spacing="6" styleClass="qm-panel" HBox.hgrow="ALWAYS">
                        <Label text="Sản phẩm bán ra" styleClass="qm-label-muted"/>
                        <Label fx:id="lblSPBanRa" text="0" styleClass="qm-value"/>
                    </VBox>
                    <VBox spacing="6" styleClass="qm-panel" HBox.hgrow="ALWAYS">
                        <Label text="Sản phẩm sắp hết" styleClass="qm-label-muted"/>
                        <Label fx:id="lblSPSapHet" text="0" styleClass="qm-warning-value"/>
                    </VBox>
                </HBox>
                <VBox spacing="10" styleClass="qm-content">
                    <GridPane hgap="12" vgap="12" VBox.vgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints percentHeight="50"/>
                            <RowConstraints percentHeight="50"/>
                        </rowConstraints>

                        <BarChart fx:id="bcDoanhThu" title="Doanh thu (7 ngày)" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <xAxis>
                                <CategoryAxis fx:id="xAxis" label="Ngày" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="yAxis" label="VNĐ" />
                            </yAxis>
                        </BarChart>

                        <LineChart fx:id="lcDonHang" title="Số hóa đơn (7 ngày)" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <xAxis>
                                <CategoryAxis label="Ngày" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Số lượng" />
                            </yAxis>
                        </LineChart>

                        <PieChart fx:id="pcTopSP" title="Top sản phẩm (30 ngày)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>

                        <AreaChart fx:id="acSPBan" title="Sản phẩm bán ra (7 ngày)" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <xAxis>
                                <CategoryAxis label="Ngày" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Số lượng" />
                            </yAxis>
                        </AreaChart>
                    </GridPane>
                </VBox>
            </VBox>
        </center>
    </BorderPane>
</AnchorPane>

